{
  "name": "snutt-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
